{
  "_comment": "Peer-review proxy random search. Cheap first pass after the full LoCoMo-dev search proved too expensive: tune on one LoCoMo-dev conversation, no LLM judge, then confirm top candidates on the full dev split before any held-out evaluation.",
  "study_name": "peer-review-locomo-dev-proxy-random",
  "sampler": "random",
  "seed": 20260511,
  "n_trials": 10,
  "n_repeats_per_trial": 1,
  "benchmark": "locomo",
  "phase_tag": "peer_review_locomo_dev_proxy_random",
  "extra_args": [
    "--data", "tuning/splits/peer_review_20260511/locomo_dev.json",
    "--adapter", "cognitive_memory",
    "--model", "gpt-4o-mini",
    "--prompt-mode", "mem0",
    "--dual-perspective",
    "--deep-recall",
    "--rerank", "--rerank-factor", "3",
    "--top-k", "60",
    "--max-conversations", "1",
    "--quiet"
  ],
  "fitness": {
    "_comment": "Token F1 on one LoCoMo-dev conversation. This is only a proxy screen; do not report as final tuning evidence.",
    "weights": {
      "aggregate.overall.mean_f1": 1.0
    }
  },
  "score_keys": [
    "aggregate.overall.mean_f1",
    "aggregate.by_category.multi-hop.mean_f1",
    "aggregate.by_category.temporal.mean_f1"
  ],
  "search_space": {
    "retrieval_score_exponent": {"type": "float", "low": 0.1, "high": 0.7},
    "power_decay_gamma": {"type": "float", "low": 0.5, "high": 1.5},
    "associative_boost": {"type": "float", "low": 0.01, "high": 0.10},
    "direct_boost": {"type": "float", "low": 0.05, "high": 0.25},
    "association_strengthen_amount": {"type": "float", "low": 0.05, "high": 0.25},
    "association_retrieval_threshold": {"type": "float", "low": 0.20, "high": 0.45},
    "base_decay_rates.semantic": {"type": "float", "low": 60.0, "high": 365.0},
    "base_decay_rates.episodic": {"type": "float", "low": 14.0, "high": 90.0},
    "decay_floors.core": {"type": "float", "low": 0.40, "high": 0.80},
    "decay_floors.regular": {"type": "float", "low": 0.00, "high": 0.10},
    "core_session_threshold": {"type": "int", "low": 1, "high": 4},
    "core_access_threshold": {"type": "int", "low": 3, "high": 20},
    "core_stability_threshold": {"type": "float", "low": 0.60, "high": 0.95},
    "consolidation_retention_threshold": {"type": "float", "low": 0.10, "high": 0.30},
    "consolidation_similarity_threshold": {"type": "float", "low": 0.50, "high": 0.85},
    "deep_recall_penalty": {"type": "float", "low": 0.25, "high": 0.75}
  }
}
